104:ddr_memtester_test()
105-{
106-    ddr_stage_start memtester
107-    mem=$(free | grep Mem | awk '{print $4}')
108-	mem=`expr $mem / 1024`
109-    mem=$(($mem-10))
110-
111-	touch "${TEST_DIR}/memtester_${count}.log"
112-	chmod 777 "${TEST_DIR}/memtester_${count}.log"
113-	### $mem：测试内存大小（MB）  1：测试轮数（仅运行1轮）
114-	memtester $mem 1 2>&1 | tee -a "${TEST_DIR}/memtester_${count}.log"
115-	memtester_result=`cat "${TEST_DIR}/memtester_${count}.log" | sed -n '9,29p'`
116-	echo "$num.ddr memtester result: $memtester_result" >> "${DDR_LOG}"
117-	num=$(($num+1))
118-	echo "===== DDR Memtestertest Completed =====" >> "${DDR_LOG}"
119-    ddr_stage_end
